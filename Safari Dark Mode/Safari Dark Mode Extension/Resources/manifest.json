{
  "manifest_version": 3,
  "name": "Safari Dark Mode",
  "version": "0.2.4",
  "description": "Personal dark mode for Gmail, Google Sheets, and Google Search in Safari.",
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "base.css",
        "gmail.css"
      ],
      "js": [
        "site-registry.js",
        "preload.js",
        "gmail-messages.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://ogs.google.com/*"
      ],
      "js": [
        "site-registry.js",
        "preload.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://myaccount.google.com/*"
      ],
      "js": [
        "site-registry.js",
        "preload.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://docs.google.com/spreadsheets/*"
      ],
      "css": [
        "sheets.css"
      ],
      "js": [
        "site-registry.js",
        "preload.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://google.com/search*",
        "https://www.google.com/search*"
      ],
      "css": [
        "base.css",
        "google-search.css"
      ],
      "js": [
        "site-registry.js",
        "preload.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "base.css",
        "gmail.css",
        "google-search.css",
        "sheets.css"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://ogs.google.com/*",
        "https://accounts.google.com/*",
        "https://myaccount.google.com/*",
        "https://docs.google.com/*",
        "https://google.com/*",
        "https://www.google.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://ogs.google.com/*",
    "https://accounts.google.com/*",
    "https://myaccount.google.com/*",
    "https://docs.google.com/spreadsheets/*",
    "https://google.com/search*",
    "https://www.google.com/search*"
  ],
  "action": {
    "default_title": "Safari Dark Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
